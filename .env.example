# Copy to .env.local. Use only a Supabase project's public URL and anon/publishable key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-only owner allowlist. Keep the real value out of source control.
ADMIN_EMAIL=owner@example.com
